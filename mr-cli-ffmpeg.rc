#include <windows.h>
#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#define APSTUDIO_HIDDEN_SYMBOLS
#undef APSTUDIO_HIDDEN_SYMBOLS
#undef APSTUDIO_READONLY_SYMBOLS

IDI_APP_ICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,1,0
 PRODUCTVERSION 1,1,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MR"
            VALUE "FileDescription", "MR CLI FOR FFMPEG - Video Editor & Converter"
            VALUE "FileVersion", "1.1.1.0"
            VALUE "InternalName", "mr-cli-ffmpeg.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026 MR. All rights reserved."
            VALUE "OriginalFilename", "mr-cli-ffmpeg.exe"
            VALUE "ProductName", "MR CLI FOR FFMPEG"
            VALUE "ProductVersion", "1.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
